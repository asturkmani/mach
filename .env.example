# --- WorkOS AuthKit (dashboard.workos.com → API Keys / Redirects) ---
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# At least 32 characters: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
# Must match a redirect URI in the WorkOS dashboard
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# --- Neon Postgres (Vercel Marketplace → Neon; `vercel env pull` fills this in) ---
DATABASE_URL=

# --- AI ---
# Vercel AI Gateway key (not needed on Vercel deployments, which use OIDC).
AI_GATEWAY_API_KEY=
# Models are chosen per company by role (lib/ai/lineup.ts): Claude when it brought an Anthropic key,
# else OpenAI. Companies and agents can pick their own in the app.
# Optional: the AI Gateway model that transcribes voice messages (defaults to spacexai/grok-stt).
TRANSCRIPTION_MODEL=

# --- Files, sandboxes and recurring jobs ---
# A private Vercel Blob store for files and the company drive (`vercel blob create-store`
# connects one and sets this). Without it, file content is kept in Postgres and drive uploads are off.
BLOB_READ_WRITE_TOKEN=
# Vercel Sandbox uses the project's OIDC token: `vercel link` then `vercel env pull`.
VERCEL_OIDC_TOKEN=
# Bearer token Vercel Cron sends to /api/cron/tick, which starts recurring jobs. Any long random string.
CRON_SECRET=

# --- Integrations ---
# Seals the credentials of data sources and website logins (and saved sessions) in the database.
# 32 random bytes, base64: openssl rand -base64 32. Keep it stable: changing it makes saved credentials unreadable.
MACH_SECRETS_KEY=

# --- Domain ---
# Optional: the one host people should use (e.g. trymach1.app). Pages opened on any other host (the old
# .vercel.app address) redirect there; webhooks and /callback don't. Set it only once WorkOS accepts
# https://<this host>/callback as a redirect URI, and NEXT_PUBLIC_WORKOS_REDIRECT_URI points at it.
CANONICAL_HOST=

# --- Push notifications for the installed app (docs/app.md) ---
# A VAPID key pair: `npx web-push generate-vapid-keys`. Without it, Mach1 doesn't
# offer push (the browser still notifies while Mach1 is open in a tab).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: who push services contact about Mach1's notifications (mailto: or https:). Defaults to APP_URL.
VAPID_SUBJECT=

# --- Talking to the Chief of Staff outside the app (docs/channels.md) ---
# The app's public URL, for links in WhatsApp and email replies (Vercel's production URL by default).
APP_URL=
# WhatsApp through Twilio: the account, and the WhatsApp sender people message (e.g. whatsapp:+14155238886).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Optional: an approved WhatsApp template (Twilio Content SID, HX…) for writing first once 24 hours have passed
# since someone's last message (docs/channels.md). Without it, those messages go to the app with a push.
TWILIO_WHATSAPP_TEMPLATE_SID=
# Optional: the exact webhook URL configured in Twilio, if it differs from the one requests arrive on.
TWILIO_WEBHOOK_URL=
# Email through AgentMail: an API key, and the webhook's signing secret (pnpm email:webhook prints it).
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=


# --- Each person's own GitHub (docs/github.md) ---
# Mach1's GitHub App: people connect their own GitHub in Settings → Account, and agents
# work in their repositories as them. Without these, the GitHub row says it isn't set up.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The app's name in its URL (github.com/apps/<slug>), for "Choose repositories".
GITHUB_APP_SLUG=
# Optional: only if the app's callback URL isn't <this site>/connect/github/callback.
GITHUB_APP_REDIRECT_URI=
