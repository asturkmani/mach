# Vercel AI Gateway key (not needed on Vercel deployments, which use OIDC).
AI_GATEWAY_API_KEY=

# AI Gateway model id for the Chief of Staff, e.g. anthropic/<model>.
# List: https://ai-gateway.vercel.sh/v1/models
CHIEF_OF_STAFF_MODEL=

# Optional. When set (Vercel Blob store connected), the profile is stored in
# Blob instead of ./data/company-profile.md.
# BLOB_READ_WRITE_TOKEN=
